# Copy this file to `.env` and fill in the values.
# Never commit your real `.env` file.

# ─── Server ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
# Frontend URL, used for CORS and Stripe success/cancel redirects
CLIENT_URL=http://localhost:3000

# ─── Database (PostgreSQL / Prisma Postgres) ─────────────
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ─── Password Hashing ────────────────────────────────────
BCRYPT_SALT_ROUNDS=10

# ─── JWT ─────────────────────────────────────────────────
# Use long, random strings (e.g. `openssl rand -base64 32`)
JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_REFRESH_SECRET=your_jwt_refresh_secret
# Durations accepted by jsonwebtoken, e.g. 15m, 1h, 1d, 7d
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# ─── Stripe ──────────────────────────────────────────────
# Price ID from the Stripe dashboard (starts with `price_`, not `prod_`)
STRIPE_PRODUCT_PRICE_ID=price_xxxxxxxxxxxxxx

#API Secret Key
STRIPE_SECRET_KEY=YOUR_SECRET_KEY

STRIPE_WEBHOOK_SECRET=YOUR_LOCAL_MACHINE_STRIPE_WEBHOOK_SECRET